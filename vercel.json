{
  "crons": [
    { "path": "/api/agent", "schedule": "0 7 * * *" }
  ],
  "functions": {
    "api/agent-clienti.js": { "maxDuration": 300 },
    "api/agent.js": { "maxDuration": 60 },
    "api/admin.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/agent.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
